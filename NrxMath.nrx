CLASS NrxMath SHARED
  PROPERTIES PRIVATE STATIC
    randy = java.util.Random()

----------- randNum -------------------------------------------------------------
-- A random number generator which operates like ooRexx's random function.
-- However, the max returnable value is 2,147,483,646

  METHOD randNum(min = 0, max = 2147483646, seed = 0) PUBLIC STATIC
  IF seed > 0 THEN 
    randy.setSeed(seed)
    
  IF min = 0 & max = 1 THEN
    RETURN randy.nextDouble()
  ELSE
    RETURN (randy.nextDouble() * (max - min) + min).trunc()
