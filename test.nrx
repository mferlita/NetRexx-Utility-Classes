
---------- Strings --------------------------------------------------------------
letters = "aBcCdDeEfF"

SAY "Strings"
SAY NrxString.capitalize(letters)
SAY NrxString.swapCase(letters)
SAY
---------- Math -----------------------------------------------------------------
SAY "Random Number Generator"
SAY NrxMath.randNum() "no input"
SAY NrxMath.randNum() "no input"
SAY NrxMath.randNum() "no input"
SAY
SAY NrxMath.randNum(12) "min 12, max default"
SAY NrxMath.randNum(0,12) "min 12, max default"
SAY
SAY NrxMath.randNum(1930,1950) "Range: 1930 - 1950"
SAY
SAY NrxMath.randNum(0,1) "Decimal between 0 and 1"
SAY NrxMath.randNum(0,1) "Decimal between 0 and 1"
SAY NrxMath.randNum(0,1) "Decimal between 0 and 1"

SAY NrxMath.randNum(1) "min 1, max default"

SAY NrxMath.randNum(0,999999999) "min 0, max 999,999,999"-- 999,999,999
SAY

SAY "Setting the seed"
SAY NrxMath.randNum(0,0,1976)
SAY NrxMath.randNum(0,100)
SAY NrxMath.randNum(0,100)
SAY NrxMath.randNum(0,100)
SAY
SAY NrxMath.randNum(0,0,1976)
SAY NrxMath.randNum(0,100)
SAY NrxMath.randNum(0,100)
SAY NrxMath.randNum(0,100)
SAY
---------- Arrays ---------------------------------------------------------------
SAY "arrays"

-- Create empty
a = NrxArray()

-- Create with values
b = NrxArray([10, 20, 30, 40, 50])

-- Size
say b.items
say b.isEmpty

-- Read
say b.at(0)
say b.at(2)
say b.last
say b.lastItem

-- Write
b.put(0, 99)
say b.at(0)         

-- Append
b.append(60)
say b.items
say b.lastItem

-- Remove at index
b.remove(0)
say b.at(0)

-- Sort
c = NrxArray([5, 3, 8, 1, 9])
c.sort()
say c.join(', ')

-- Join with custom separator
say c.join(' | ')

-- Join with default (newline)
say c.join      
